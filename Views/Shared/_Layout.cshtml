<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SistemaMVC</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SistemaMVC.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">SistemaMVC</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Pessoa" asp-action="Index">👥 Pessoas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Endereco" asp-action="Index">📍 Endereços</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark"
                            href="#"
                            id="navbarContato"
                            role="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">
                                👤 Contatos
                            </a>

                            <ul class="dropdown-menu shadow" aria-labelledby="navbarContato">

                                <li>
                                    <a class="dropdown-item"
                                    asp-controller="Contato"
                                    asp-action="Index">
                                        <b> Inicio Contatos</b>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item"
                                    asp-controller="Contato"
                                    asp-action="ListarContatos">
                                        📋 Listar Contatos
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                    asp-controller="Contato"
                                    asp-action="CriarContato">
                                        ➕ Adicionar Contato
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                    asp-controller="Contato"
                                    asp-action="BuscarContato">
                                        🔎 Buscar Contato
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                    asp-controller="Contato"
                                    asp-action="AtualizarContato">
                                        ✏️ Editar Contato
                                    </a>
                                </li>

                                <li><hr class="dropdown-divider"></li>

                                <li>
                                    <a class="dropdown-item text-danger"
                                    asp-controller="Contato"
                                    asp-action="ExcluirContato">
                                        🗑️ Excluir Contato
                                    </a>
                                </li>

                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - SistemaMVC - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
