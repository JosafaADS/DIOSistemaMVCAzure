@model SistemaMVC.ViewModels.EnderecosViewModel
@{
    ViewData["Title"] = "Novo Endereço";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">🏠 @ViewData["Title"]</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Criar">
                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label asp-for="Endereco.PessoaId" class="form-label">Pessoa</label>
                                <select asp-for="Endereco.PessoaId" class="form-control" asp-items="@(new SelectList(Model.Pessoas, "Id", "Nome"))">
                                    <option value="">-- Selecione uma Pessoa --</option>
                                </select>
                            </div>
                            <div class="col-md-9 mb-3">
                                <label asp-for="Endereco.Rua" class="form-label"></label>
                                <input asp-for="Endereco.Rua" class="form-control" />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label asp-for="Endereco.Numero" class="form-label"></label>
                                <input asp-for="Endereco.Numero" class="form-control" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Endereco.Bairro" class="form-label"></label>
                                <input asp-for="Endereco.Bairro" class="form-control" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Endereco.Cidade" class="form-label"></label>
                                <input asp-for="Endereco.Cidade" class="form-control" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Endereco.Estado" class="form-label"></label>
                                <input asp-for="Endereco.Estado" class="form-control" />
                            </div>
                            <div class="col-md-8 mb-3">
                                <label asp-for="Endereco.Complemento" class="form-label"></label>
                                <input asp-for="Endereco.Complemento" class="form-control" />
                            </div>
                        </div>
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                            <a asp-action="Index" class="btn btn-light me-md-2">Cancelar</a>
                            <button type="submit" class="btn btn-primary px-4">Salvar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
