@model IEnumerable<SistemaMVC.Models.Endereco>
@{
    ViewData["Title"] = "Lista de Endereços";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5 text-primary">📍 @ViewData["Title"]</h1>
        <a asp-action="Criar" class="btn btn-success btn-lg shadow-sm">
            <i class="bi bi-plus-circle"></i> Novo Endereço
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Pessoa</th>
                        <th>Rua</th>
                        <th>Nº</th>
                        <th>Cidade</th>
                        <th>Bairro</th>
                        <th class="text-center">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="align-middle fw-bold">@item.Pessoa?.Nome</td>
                            <td class="align-middle">@item.Rua</td>
                            <td class="align-middle">@item.Numero</td>
                            <td class="align-middle">@item.Cidade</td>
                            <td class="align-middle">@item.Bairro</td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Editar</a>
                                    <a asp-action="Excluir" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm" onclick="return confirm('Tem certeza?')">Excluir</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
